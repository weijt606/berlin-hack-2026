# Vibe Rave — environment configuration
# Copy to .env and fill in. .env is gitignored; never commit secrets.

# ─── ai-coustics (speech enhancement, REQUIRED for the in-the-wild demo) ────
# https://developers.ai-coustics.com
AIC_SDK_LICENSE=
# 0.5 dev, 0.8 noisy stage (per ai-coustics ASR-tuning guide)
AIC_ENHANCEMENT_LEVEL=0.8

# ─── LLM provider (REQUIRED — Gemini default, Ollama optional) ──────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_TEMPERATURE=0.85

# Set LLM_PROVIDER=ollama for fully-offline mode (no API key needed)
LLM_PROVIDER=gemini
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# Whether to run a Gemini cleanup pass over Whisper output (~600 ms)
LLM_CORRECT_TRANSCRIPT=true

# ─── Pioneer GLiNER2 (per-track viz classifier, OPTIONAL) ───────────────────
# Without these the viz auto-recommend feature 503s; the rest of the app works.
PIONEER_API_KEY=
PIONEER_VIZ_MODEL_ID=

# ─── Whisper STT (local, smart-whisper auto-downloads on first use) ─────────
WHISPER_MODEL=medium.en        # base.en | small.en | medium.en | large-v3-turbo
WHISPER_LANGUAGE=en            # skip auto-detect for speed + accuracy
WHISPER_GPU=true               # Metal on macOS; CUDA on Linux

# ─── API server ─────────────────────────────────────────────────────────────
API_PORT=4322
API_HOST=0.0.0.0
# Toggle per-call audio + transcript dumps under data/stage-dumps/ (PII!)
API_DUMP_STAGES=
